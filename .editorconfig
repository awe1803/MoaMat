# MoaMat — C# coding conventions.
# Rules that matter for review are set to `warning`; the build turns warnings
# into errors (see Directory.Build.props).
root = true

[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,md}]
indent_size = 2

[*.{csproj,props,targets,slnx}]
indent_size = 2

[*.cs]
# --- Language conventions -------------------------------------------------
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
csharp_prefer_braces = true:warning
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_prefer_primary_constructors = true:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_readonly_field = true:warning
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning

# --- Naming: private fields are _camelCase --------------------------------
dotnet_naming_rule.private_fields_are_camel_case_with_underscore.severity = warning
dotnet_naming_rule.private_fields_are_camel_case_with_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_are_camel_case_with_underscore.style = underscore_camel_case

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_fields.required_modifiers =

dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _

# --- Diagnostics tuned for this codebase ----------------------------------
# CA1848: LoggerMessage source generators are overkill for a small WASM client.
dotnet_diagnostic.CA1848.severity = none
# CA1707: SQL-facing identifiers occasionally need underscores.
dotnet_diagnostic.CA1707.severity = suggestion
# CA1054/CA1056: Supabase exposes URLs as strings.
dotnet_diagnostic.CA1054.severity = none
dotnet_diagnostic.CA1056.severity = none
# CA1002/CA2227: DTO collection properties are set by the JSON deserializer.
dotnet_diagnostic.CA2227.severity = none
# CA1000: result types expose their factories as statics (Result<T>.Success), by design.
dotnet_diagnostic.CA1000.severity = none
# CA1062: nullable reference types already document argument nullability.
dotnet_diagnostic.CA1062.severity = none
# Swallowing a broad exception must stay visible.
dotnet_diagnostic.CA1031.severity = warning
# Culture must always be explicit.
dotnet_diagnostic.CA1305.severity = warning
dotnet_diagnostic.CA1304.severity = warning
dotnet_diagnostic.CA1310.severity = warning

[tests/**/*.cs]
# Test classes are instantiated by the runner and may expose public nested types.
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none

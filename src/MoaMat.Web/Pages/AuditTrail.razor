@page "/journal-audit"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Journal d'audit — MoaMat</PageTitle>

<AuthorizeView Policy="@AuthorizationPolicyNames.AdministratorOrHigher">
    <NotAuthorized>
        <div class="page-head"><h1>Journal d'audit</h1></div>
        <p class="msg-error" role="alert">
            Cet écran est réservé aux rôles <strong>administrateur</strong> et
            <strong>super-administrateur</strong>.
        </p>
    </NotAuthorized>
    <Authorized>
        <div class="page-head">
            <h1>Journal d'audit</h1>
            <div class="sub">
                Événements sensibles tracés automatiquement (changements de rôle,
                changements de statut terminal…). Journal en ajout seul : aucune
                entrée ne peut être modifiée ni supprimée.
            </div>
        </div>

        <div class="toolbar">
            <label class="field">
                <span>Type d'événement</span>
                <select @bind="_actionFilter" @bind:after="ReloadAsync">
                    <option value="">Tous</option>
                    <option value="role.assigned">Rôle attribué</option>
                    <option value="role.changed">Rôle modifié</option>
                    <option value="role.revoked">Rôle retiré</option>
                    <option value="superadmin.nominated">Nomination super-admin</option>
                    <option value="status.terminal">Statut terminal</option>
                </select>
            </label>
            <button type="button" class="btn" @onclick="ReloadAsync" disabled="@_isBusy">
                <Icon Name="refresh" Size="14" />
                Rafraîchir
            </button>
        </div>

        @if (_error is not null)
        {
            <p class="msg-error" role="alert">@_error</p>
        }

        @if (_isBusy)
        {
            <p class="msg-muted">Chargement du journal…</p>
        }
        else if (_entries.Count == 0)
        {
            <div class="data-list"><p class="data-empty">Aucun événement.</p></div>
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Date (UTC)</th>
                            <th>Auteur</th>
                            <th>Action</th>
                            <th>Table</th>
                            <th>Réf.</th>
                            <th>Avant → Après</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in _entries)
                        {
                            <tr>
                                <td class="mono">@Timestamps.Second(entry.OccurredAt)</td>
                                <td>@(entry.ActorEmail ?? entry.ActorId?.ToString() ?? "système")</td>
                                <td><code>@entry.Action</code></td>
                                <td>@entry.EntityTable</td>
                                <td class="mono">@entry.EntityId</td>
                                <td>
                                    <code>@AuditPayloadFormatter.Format(entry.Before)</code> →
                                    <code>@AuditPayloadFormatter.Format(entry.After)</code>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="count-foot">@_entries.Count entrée(s) affichée(s) — les plus récentes d'abord.</p>
        }
    </Authorized>
</AuthorizeView>

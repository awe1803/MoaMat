@page "/comptes"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Comptes utilisateurs — MoaMat</PageTitle>

<AuthorizeView Policy="@AuthorizationPolicyNames.AdministratorOrHigher">
    <NotAuthorized>
        <div class="page-head"><h1>Comptes utilisateurs</h1></div>
        <p class="msg-error" role="alert">
            Cet écran est réservé aux rôles <strong>administrateur</strong> et
            <strong>super-administrateur</strong>.
        </p>
    </NotAuthorized>
    <Authorized>
        <div class="page-head">
            <h1>Comptes utilisateurs</h1>
            <div class="sub">
                Attribution des rôles et activation des comptes. Chaque changement est
                inscrit au <a href="journal-audit">journal d'audit</a>. Un compte n'est
                jamais supprimé — uniquement désactivé.
            </div>
        </div>

        <div class="toolbar">
            <button type="button" class="btn" @onclick="ReloadAsync" disabled="@_isBusy">
                <Icon Name="refresh" Size="14" />
                Rafraîchir
            </button>
        </div>

        @if (_error is not null)
        {
            <p class="msg-error" role="alert">@_error</p>
        }

        @if (_isBusy)
        {
            <p class="msg-muted">Chargement des comptes…</p>
        }
        else if (_accounts.Count == 0)
        {
            <div class="data-list"><p class="data-empty">Aucun compte.</p></div>
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>E-mail</th>
                            <th>Rôle</th>
                            <th>État</th>
                            <th>Dernière connexion (UTC)</th>
                            <th>Créé le</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var account in _accounts)
                        {
                            <tr class="@(account.IsDisabled ? "row-off" : null)">
                                <td>
                                    @account.Email
                                    @if (!_policy.CanChangeRoleOf(account) && !_policy.CanChangeActivationOf(account))
                                    {
                                        <span class="badge off">protégé</span>
                                    }
                                </td>
                                <td>
                                    <select value="@account.Role.Code"
                                            @onchange="e => ChangeRoleAsync(account, e.Value as string)"
                                            disabled="@(!_policy.CanChangeRoleOf(account))"
                                            aria-label="@($"Rôle de {account.Email}")">
                                        @foreach (var role in AppRole.Assignable)
                                        {
                                            <option value="@role.Code" disabled="@(!_policy.CanAssignRole(role))">
                                                @role.Code
                                            </option>
                                        }
                                    </select>
                                </td>
                                <td class="cell-state">
                                    @if (account.IsDisabled)
                                    {
                                        <span class="badge off">Désactivé</span>
                                    }
                                    else
                                    {
                                        <span class="badge on">Actif</span>
                                    }
                                    <button type="button" class="btn btn-sm"
                                            @onclick="() => ToggleActivationAsync(account)"
                                            disabled="@(_isBusy || !_policy.CanChangeActivationOf(account))">
                                        @(account.IsDisabled ? "Réactiver" : "Désactiver")
                                    </button>
                                </td>
                                <td class="mono">@Timestamps.Minute(account.LastSignInAt)</td>
                                <td class="mono">@Timestamps.Day(account.CreatedAt)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="count-foot">
                @_accounts.Count compte(s). « CA » = compte au rôle <code>lecture</code> ;
                sa désactivation est réservée au super-administrateur.
            </p>
        }
    </Authorized>
</AuthorizeView>

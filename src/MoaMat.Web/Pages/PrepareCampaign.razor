@page "/campagnes/preparer"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using MoaMat.Domain.Accounts
@using MoaMat.Domain.Campaigns
@using MoaMat.Domain.Inventory
@using MoaMat.Web.Presentation

<PageTitle>Préparer une campagne — MoaMat</PageTitle>

<AuthorizeView Policy="@AuthorizationPolicyNames.ManagerOrHigher">
    <NotAuthorized>
        <div class="page-head"><h1>Préparer une campagne</h1></div>
        <p class="msg-error" role="alert">
            Cet écran est réservé aux rôles <strong>gestion</strong> et au-dessus.
        </p>
    </NotAuthorized>
    <Authorized>
        <div class="page-head">
            <h1>Préparer une campagne</h1>
            <div class="sub">
                Regroupe les bouteilles proches de leur échéance (@InventoryItem.DueSoonHorizonInDays jours)
                pour un envoi groupé chez le prestataire. Le bordereau ne peut être généré
                que lorsque chaque bouteille a une prestation choisie.
            </div>
        </div>

        @if (_error is not null)
        {
            <p class="msg-error" role="alert">@_error</p>
        }

        @if (_isBusy)
        {
            <p class="msg-muted">Chargement…</p>
        }
        else if (!HasCampaign)
        {
            @if (_resumableCampaigns.Count > 0)
            {
                <div class="page-head">
                    <div class="sub">
                        Campagne(s) en préparation non terminée(s) — le bordereau n'a pas encore
                        été généré pour ces bouteilles, déjà engagées et indisponibles pour une
                        nouvelle sélection tant qu'elles ne sont pas reprises ici.
                    </div>
                </div>
                <div class="table-scroll">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Campagne</th>
                                <th>Prestataire</th>
                                <th>Bouteilles</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var campaign in _resumableCampaigns)
                            {
                                <tr>
                                    <td>#@campaign.Id</td>
                                    <td>@campaign.Provider</td>
                                    <td>@campaign.Lines.Count</td>
                                    <td>
                                        <a class="btn btn-sm" href="@RouteFor(campaign.Id)">Reprendre</a>
                                        <AuthorizeView Policy="@AuthorizationPolicyNames.SuperAdministrator" Context="superAdmin">
                                            @if (_pendingDeleteId == campaign.Id)
                                            {
                                                <span class="msg-muted">Suppression définitive, irréversible.</span>
                                                <button type="button" class="btn btn-sm danger"
                                                        @onclick="() => DeleteCampaignAsync(campaign)" disabled="@_isSubmitting">
                                                    Confirmer
                                                </button>
                                                <button type="button" class="btn btn-sm" @onclick="CancelDelete" disabled="@_isSubmitting">
                                                    Annuler
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-sm danger"
                                                        @onclick="() => RequestDelete(campaign)" disabled="@_isSubmitting">
                                                    Supprimer
                                                </button>
                                            }
                                        </AuthorizeView>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="toolbar">
                <label>
                    Fournisseur
                    <select @bind="_provider" disabled="@(_suppliers.Count == 0)">
                        @foreach (var supplier in _suppliers)
                        {
                            <option value="@supplier.Name">@supplier.Name</option>
                        }
                    </select>
                </label>
                <a class="btn btn-sm" href="fournisseurs">Gérer les fournisseurs et prestations</a>
                <button type="button" class="btn" @onclick="CreateCampaignAsync"
                        disabled="@(_selectedItemIds.Count == 0 || _isSubmitting)">
                    Créer la campagne (@_selectedItemIds.Count sélectionnée(s))
                </button>
            </div>

            @if (_dueSoonItems.Count == 0)
            {
                <div class="data-list"><p class="data-empty">Aucune bouteille proche de son échéance.</p></div>
            }
            else
            {
                <div class="table-scroll">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Code club</th>
                                <th>Échéance</th>
                                <th>Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _dueSoonItems)
                            {
                                var status = item.DueStatusOn(DateOnly.FromDateTime(DateTime.Today));
                                <tr>
                                    <td>
                                        <input type="checkbox"
                                               checked="@_selectedItemIds.Contains(item.Id)"
                                               @onchange="e => ToggleSelection(item.Id, (bool)(e.Value ?? false))" />
                                    </td>
                                    <td>@(item.ClubCode ?? "—")</td>
                                    <td class="mono">@(item.DueOn?.ToString("dd/MM/yyyy") ?? "—")</td>
                                    <td><span class="@DueStatusView.BadgeClass(status)">@DueStatusView.Label(status)</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        else
        {
            <div class="page-head">
                <div class="sub">
                    Campagne #@_campaign!.Id — @_campaign.Provider — @_campaign.Lines.Count bouteille(s)
                    @if (EstimatedTotal is { } total)
                    {
                        <text> — estimation @total.ToString("0.00") €</text>
                    }
                </div>
            </div>

            <div class="toolbar">
                <label>
                    Fournisseur
                    <select value="@_campaign.SupplierId"
                            @onchange="e => ChangeSupplierAsync(e.Value as string)"
                            disabled="@_isSubmitting">
                        @foreach (var supplier in _suppliers)
                        {
                            <option value="@supplier.Id">@supplier.Name</option>
                        }
                    </select>
                </label>
                <span class="msg-muted">
                    Changer de fournisseur remet les prestations de toutes les bouteilles à choisir.
                </span>
            </div>

            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Code club</th>
                            <th>Prestation</th>
                            <th>Coût estimé</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in _campaign.Lines)
                        {
                            <tr>
                                <td>@(line.ItemClubCode ?? "—")</td>
                                <td>
                                    @* Jamais de présélection : huile / eau se choisissent explicitement, par bouteille. *@
                                    <select value="@(line.Service?.Id.ToString() ?? string.Empty)"
                                            @onchange="e => SetLineServiceAsync(line, e.Value as string)"
                                            disabled="@_isSubmitting"
                                            aria-label="@($"Prestation pour {line.ItemClubCode}")">
                                        <option value="" disabled>— à choisir —</option>
                                        @foreach (var service in _services)
                                        {
                                            <option value="@service.Id">
                                                @service.Name — @service.ControlLabel
                                                @if (PriceFor(service) is { } price)
                                                {
                                                    <text> (@price.ToString("0.00") €)</text>
                                                }
                                                else
                                                {
                                                    <text> (sans tarif)</text>
                                                }
                                                @if (!service.IsActive)
                                                {
                                                    <text> [désactivée]</text>
                                                }
                                            </option>
                                        }
                                    </select>
                                </td>
                                <td class="mono">@(line.EstimatedCostEur is { } estimate ? estimate.ToString("0.00") + " €" : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (LinesMissingService.Any())
            {
                <p class="msg-muted">
                    @LinesMissingService.Count() ligne(s) sans prestation choisie : l'envoi est bloqué tant qu'elles ne sont pas renseignées.
                </p>
            }
            else
            {
                <div class="toolbar">
                    <label>
                        N° de bon (facultatif)
                        <input type="text" @bind="_bordereauNumber" />
                    </label>
                    <label>
                        Date d'envoi
                        <input type="date" @bind="_sentOn" />
                    </label>
                    <button type="button" class="btn" @onclick="SendCampaignAsync" disabled="@_isSubmitting">
                        Générer le bordereau et envoyer
                    </button>
                </div>
                <p class="msg-muted">
                    Le numéro de bon peut être laissé vide si le prestataire ne le communique
                    qu'à la remise physique des bouteilles — il pourra être ajouté ensuite depuis
                    l'écran de retour de campagne.
                </p>
            }
        }
    </Authorized>
</AuthorizeView>

@page "/detendeurs/{ItemId:long}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using MoaMat.Domain.Accounts
@using MoaMat.Domain.Inventory
@using MoaMat.Domain.Regulators
@using MoaMat.Web.Presentation

<PageTitle>@(_item?.ClubCode ?? "Fiche détendeur") — MoaMat</PageTitle>

<AuthorizeView Policy="@AuthorizationPolicyNames.ReaderOrHigher">
    <NotAuthorized>
        <div class="page-head"><h1>Fiche détendeur</h1></div>
        <p class="msg-error" role="alert">Accès réservé aux utilisateurs authentifiés.</p>
    </NotAuthorized>
    <Authorized>
        <a class="back-link" href="inventaire?famille=detendeur">
            <Icon Name="back" Size="14" />
            Retour à la liste
        </a>

        @if (_error is not null)
        {
            <p class="msg-error" role="alert">@_error</p>
        }

        @if (_notice is not null)
        {
            <p class="msg-success" role="status">@_notice</p>
        }

        @if (_isBusy)
        {
            <p class="msg-muted">Chargement de la fiche…</p>
        }
        else if (_item is null)
        {
            <div class="data-list"><p class="data-empty">Détendeur introuvable ou non accessible.</p></div>
        }
        else
        {
            var dueStatus = _item.DueStatusOn(Today);

            <div class="fiche-head">
                <div>
                    <div class="fiche-code">
                        @(_item.ClubCode ?? $"Détendeur n° {_item.Id}")
                        @if (_item.HasAmbiguousClubCode)
                        {
                            <span class="badge ambigu" title="@_item.DescribeClubCodeAmbiguity()">code ambigu</span>
                        }
                    </div>
                    <div class="fiche-sub">@DescribeSubtitle()</div>
                </div>
                <span class="@DueStatusView.BadgeClass(dueStatus)" style="font-size:12px;padding:6px 12px;">
                    @DueStatusView.Label(dueStatus)
                </span>
            </div>

            <div class="char-grid">
                @foreach (var (label, value) in Characteristics())
                {
                    <div class="char-cell"><div class="l">@label</div><div class="v">@value</div></div>
                }
            </div>

            <div class="btn-row">
                <AuthorizeView Policy="@AuthorizationPolicyNames.ManagerOrHigher" Context="manager">
                    <button type="button" class="btn primary" @onclick="ToggleIntervention" disabled="@_isSaving"
                            aria-expanded="@_showIntervention">
                        <Icon Name="plus" Size="14" />
                        Nouvelle intervention
                    </button>
                </AuthorizeView>
            </div>

            @if (_showIntervention)
            {
                <form class="fiche-panel" @onsubmit="SaveInterventionAsync">
                    <h2 class="section-title">Nouvelle intervention — 5 points de contrôle obligatoires</h2>
                    <div class="form-grid">
                        <label class="field">
                            <span>Date de l'intervention</span>
                            <input type="date" @bind="_interventionDate" max="@Today.ToString("yyyy-MM-dd")" required />
                        </label>
                        <label class="field">
                            <span>Manomètre</span>
                            <select @bind="_ctrlGauge" required>
                                <option value="">— à choisir —</option>
                                <option value="@nameof(RegulatorControlResult.Ok)">OK</option>
                                <option value="@nameof(RegulatorControlResult.NotOk)">Non OK</option>
                                <option value="@nameof(RegulatorControlResult.NotApplicable)">Sans objet</option>
                            </select>
                        </label>
                        <label class="field">
                            <span>Détendeur (1er / 2e étage)</span>
                            <select @bind="_ctrlStages" required>
                                <option value="">— à choisir —</option>
                                <option value="@nameof(RegulatorControlResult.Ok)">OK</option>
                                <option value="@nameof(RegulatorControlResult.NotOk)">Non OK</option>
                                <option value="@nameof(RegulatorControlResult.NotApplicable)">Sans objet</option>
                            </select>
                        </label>
                        <label class="field">
                            <span>Octopus</span>
                            <select @bind="_ctrlOctopus" required>
                                <option value="">— à choisir —</option>
                                <option value="@nameof(RegulatorControlResult.Ok)">OK</option>
                                <option value="@nameof(RegulatorControlResult.NotOk)">Non OK</option>
                                <option value="@nameof(RegulatorControlResult.NotApplicable)">Sans objet</option>
                            </select>
                        </label>
                        <label class="field">
                            <span>Inflateur</span>
                            <select @bind="_ctrlInflator" required>
                                <option value="">— à choisir —</option>
                                <option value="@nameof(RegulatorControlResult.Ok)">OK</option>
                                <option value="@nameof(RegulatorControlResult.NotOk)">Non OK</option>
                                <option value="@nameof(RegulatorControlResult.NotApplicable)">Sans objet</option>
                            </select>
                        </label>
                        <label class="field">
                            <span>Visuel flexibles</span>
                            <select @bind="_ctrlHoseVisual" required>
                                <option value="">— à choisir —</option>
                                <option value="@nameof(RegulatorControlResult.Ok)">OK</option>
                                <option value="@nameof(RegulatorControlResult.NotOk)">Non OK</option>
                                <option value="@nameof(RegulatorControlResult.NotApplicable)">Sans objet</option>
                            </select>
                        </label>
                        <label class="field">
                            <span>Prestataire</span>
                            <input type="text" @bind="_interventionProvider" />
                        </label>
                        <label class="field">
                            <span>Coût (€)</span>
                            <input type="number" step="0.01" min="0" @bind="_interventionCost" />
                        </label>
                    </div>
                    <label class="field">
                        <span>Remarque</span>
                        <textarea rows="2" @bind="_interventionRemark"></textarea>
                    </label>
                    <p class="msg-info">
                        Les 5 points doivent chacun recevoir une valeur réelle (OK / Non OK / Sans objet) : la
                        saisie est bloquée tant qu'un point n'est pas renseigné.
                    </p>
                    <div class="btn-row">
                        <button type="submit" class="btn primary" disabled="@_isSaving">Enregistrer</button>
                        <button type="button" class="btn" @onclick="ToggleIntervention" disabled="@_isSaving">Annuler</button>
                    </div>
                </form>
            }

            <div class="section-title" style="margin-top:0;">Chronologie</div>
            @if (_events.Count == 0)
            {
                <div class="data-list"><p class="data-empty">Aucune intervention enregistrée pour ce détendeur.</p></div>
            }
            else
            {
                <div class="timeline">
                    @foreach (var entry in _events)
                    {
                        <div class="tl-item">
                            <span class="tl-dot @EventTone(entry)"></span>
                            <div class="tl-top">
                                <span class="tl-date">@FormatDate(entry.OccurredOn)</span>
                                <span class="tl-type">
                                    Intervention
                                    @if (entry.IsLegacyGap)
                                    {
                                        <span class="badge ambigu" title="Import historique : contrôle non réellement effectué.">NO CTL</span>
                                    }
                                </span>
                            </div>
                            <div class="tl-detail">@DescribeEvent(entry)</div>
                        </div>
                    }
                </div>
            }
        }
    </Authorized>
</AuthorizeView>

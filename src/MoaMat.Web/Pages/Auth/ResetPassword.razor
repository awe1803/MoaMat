@page "/reinitialiser-mot-de-passe"
@layout Layout.AuthLayout
@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>Réinitialiser le mot de passe — MoaMat</PageTitle>

<h1 class="auth-title">Nouveau mot de passe</h1>

@if (_stage == Stage.Checking)
{
    <p class="auth-hint">Vérification du lien…</p>
}
else if (_stage == Stage.LinkInvalid)
{
    <div class="auth-msg error" role="alert">
        @(_error ?? "Ce lien de réinitialisation est invalide ou a expiré.")
    </div>
    <div class="auth-links">
        <a href="mot-de-passe-oublie">Demander un nouveau lien</a>
    </div>
}
else if (_stage == Stage.Done)
{
    <div class="auth-msg success" role="status">
        Mot de passe mis à jour. Vous pouvez maintenant l'utiliser pour vous connecter.
    </div>
    <div class="auth-actions">
        <button type="button" class="auth-btn" @onclick="GoToApp">Continuer</button>
    </div>
}
else
{
    <p class="auth-lead">Choisissez un mot de passe d'au moins 8 caractères.</p>

    @if (_error is not null)
    {
        <div class="auth-msg error" role="alert">@_error</div>
    }

    <EditForm Model="_model" OnValidSubmit="SubmitAsync">
        <DataAnnotationsValidator />

        <div class="auth-field">
            <label for="password">Nouveau mot de passe</label>
            <InputText id="password" @bind-Value="_model.Password" type="password"
                       autocomplete="new-password" autofocus disabled="@_busy" />
            <ValidationMessage For="() => _model.Password" />
        </div>

        <div class="auth-field">
            <label for="confirm">Confirmation</label>
            <InputText id="confirm" @bind-Value="_model.Confirm" type="password"
                       autocomplete="new-password" disabled="@_busy" />
            <ValidationMessage For="() => _model.Confirm" />
        </div>

        <div class="auth-actions">
            <button type="submit" class="auth-btn" disabled="@_busy">
                @if (_busy)
                {
                    <span class="auth-spinner" aria-hidden="true"></span>
                    <span>Mise à jour…</span>
                }
                else
                {
                    <span>Définir le mot de passe</span>
                }
            </button>
        </div>
    </EditForm>
}

@code {
    private enum Stage { Checking, LinkInvalid, Form, Done }

    private readonly NewPassword _model = new();
    private Stage _stage = Stage.Checking;
    private bool _busy;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        // Le lien de l'e-mail renvoie ici avec les jetons dans le fragment
        // (#access_token=…&type=recovery). On établit la session avant de
        // permettre la saisie du nouveau mot de passe.
        if (Auth.IsSignedIn)
        {
            _stage = Stage.Form;
            return;
        }

        var result = await Auth.EstablishSessionFromUrlAsync();
        _stage = result.Succeeded ? Stage.Form : Stage.LinkInvalid;
        _error = result.Succeeded ? null : result.Error;
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;

        var result = await Auth.UpdatePasswordAsync(_model.Password);

        _busy = false;

        if (result.Succeeded)
        {
            _stage = Stage.Done;
        }
        else
        {
            _error = result.Error;
        }
    }

    private void GoToApp() => Navigation.NavigateTo("", replace: true);

    private sealed class NewPassword
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Mot de passe requis.")]
        [System.ComponentModel.DataAnnotations.MinLength(8, ErrorMessage = "8 caractères minimum.")]
        public string Password { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Compare(nameof(Password), ErrorMessage = "Les mots de passe ne correspondent pas.")]
        public string Confirm { get; set; } = "";
    }
}

@page "/mot-de-passe-oublie"
@layout Layout.AuthLayout
@inject AuthService Auth

<PageTitle>Mot de passe oublié — MoaMat</PageTitle>

<h1 class="auth-title">Mot de passe oublié</h1>
<p class="auth-lead">Indiquez votre adresse e-mail : un lien de réinitialisation vous sera envoyé.</p>

@if (_sent)
{
    <div class="auth-msg success" role="status">
        Si un compte existe pour <b>@_model.Email</b>, un e-mail contenant un lien de
        réinitialisation vient d'être envoyé. Pensez à vérifier vos courriers indésirables.
    </div>
    <div class="auth-links">
        <a href="connexion">Retour à la connexion</a>
    </div>
}
else
{
    @if (_error is not null)
    {
        <div class="auth-msg error" role="alert">@_error</div>
    }

    <EditForm Model="_model" OnValidSubmit="SubmitAsync">
        <DataAnnotationsValidator />

        <div class="auth-field">
            <label for="email">Adresse e-mail</label>
            <InputText id="email" @bind-Value="_model.Email" type="email" autocomplete="username"
                       autofocus disabled="@_busy" />
            <ValidationMessage For="() => _model.Email" />
        </div>

        <div class="auth-actions">
            <button type="submit" class="auth-btn" disabled="@_busy">
                @if (_busy)
                {
                    <span class="auth-spinner" aria-hidden="true"></span>
                    <span>Envoi…</span>
                }
                else
                {
                    <span>Envoyer le lien</span>
                }
            </button>
        </div>
    </EditForm>

    <div class="auth-links">
        <a href="connexion">Retour à la connexion</a>
    </div>
}

@code {
    private readonly EmailOnly _model = new();
    private bool _busy;
    private bool _sent;
    private string? _error;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;

        var result = await Auth.SendPasswordResetEmailAsync(_model.Email);

        _busy = false;

        if (result.Succeeded)
        {
            _sent = true;
        }
        else
        {
            _error = result.Error;
        }
    }

    private sealed class EmailOnly
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "E-mail requis.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "E-mail invalide.")]
        public string Email { get; set; } = "";
    }
}

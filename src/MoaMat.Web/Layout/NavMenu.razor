<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">MoaMat</a>
        <button title="Menu de navigation" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Accueil
            </NavLink>
        </div>
        <AuthorizeView Policy="@AuthorizationPolicyNames.ReaderOrHigher">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="inventaire">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Inventaire
                </NavLink>
            </div>
        </AuthorizeView>
        <AuthorizeView Policy="@AuthorizationPolicyNames.AdministratorOrHigher">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="lieux">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Lieux
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="comptes">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Comptes
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="journal-audit">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Journal d'audit
                </NavLink>
            </div>
        </AuthorizeView>
    </nav>

    <AuthorizeView>
        <div class="nav-user">
            <div class="nav-user-id">
                <span class="nav-user-avatar">
                    @UserInitials.FromDisplayName(context.User.Identity?.Name)
                </span>
                <span class="nav-user-email" title="@context.User.Identity?.Name">
                    @context.User.Identity?.Name
                </span>
            </div>
            <a class="nav-user-signout" href="deconnexion">Se déconnecter</a>
        </div>
    </AuthorizeView>
</div>


<nav class="side-nav" aria-label="Modules">
    <div class="side-brand">
        <img src="logo_Royal_Moana.png" alt="Royal Moana" />
        <span>
            <span class="brand-name">Royal Moana</span>
            <span class="brand-sub">Gestion du matériel</span>
        </span>
    </div>

    <NavLink class="side-item" href="" Match="NavLinkMatch.All">
        <Icon Name="dashboard" Size="16" />
        <span>Tableau de bord</span>
    </NavLink>

    @foreach (var group in VisibleGroups)
    {
        <div class="side-group-label">@group</div>

        @foreach (var module in VisibleModulesIn(group))
        {
            <NavLink class="side-item" href="@module.Href">
                <Icon Name="@module.Icon" Size="16" />
                <span>@module.Title</span>
                @if (!module.IsAvailable)
                {
                    <span class="side-count" title="Écran à venir">à venir</span>
                }
            </NavLink>
        }
    }
</nav>

<AuthorizeView>
    <div class="side-user">
        <div class="side-user-id">
            <span class="avatar avatar-sm">
                @UserInitials.FromDisplayName(context.User.Identity?.Name)
            </span>
            <span class="side-user-email" title="@context.User.Identity?.Name">
                @context.User.Identity?.Name
            </span>
        </div>
        <a class="side-user-signout" href="deconnexion">
            <Icon Name="logout" Size="14" />
            <span>Se déconnecter</span>
        </a>
    </div>
</AuthorizeView>

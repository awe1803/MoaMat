@inherits LayoutComponentBase
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <span class="top-user">@context.User.Identity?.Name</span>
                    <a href="deconnexion">Se déconnecter</a>
                </Authorized>
                <NotAuthorized>
                    <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <PendingAccountGate RouteData="@routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
                <Authorizing>
                    <LayoutView Layout="@typeof(Layout.AuthLayout)">
                        <p class="auth-hint">Vérification de la session…</p>
                    </LayoutView>
                </Authorizing>
            </AuthorizeRouteView>
        </PendingAccountGate>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
</Router>

@* ---------- "No internet access" page ---------- *@
@* Outside the router, and after it, on purpose: every layout needs it - signing
   in reaches the network just as much as the inventory does - and a route that
   never resolves offline must not take the explanation down with it. Coming
   after the router also leaves the routed page's own <h1> first in the
   document, where FocusOnNavigate looks for it. *@
<OfflineGate />

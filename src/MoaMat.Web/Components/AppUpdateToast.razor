@using MoaMat.Web.Pwa

@if (_isVisible)
{
    <div class="update-toast" role="status" aria-live="polite">
        <span class="update-mark"><Icon Name="refresh" Size="16" /></span>

        <div class="update-text">
            <strong>Nouvelle version disponible</strong>
            <span>Rechargez MoaMat pour profiter des dernières nouveautés.</span>
        </div>

        <div class="update-actions">
            <button type="button" class="btn primary btn-sm" @onclick="ApplyAsync" disabled="@_isBusy">
                Mettre à jour
            </button>
            <button type="button" class="btn btn-sm" @onclick="Dismiss" disabled="@_isBusy">
                Plus tard
            </button>
        </div>
    </div>
}

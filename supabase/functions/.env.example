# =============================================================================
#  Variables locales pour `supabase functions serve` (copier en .env.local et
#  NE JAMAIS commiter). En production, ces valeurs sont injectées
#  automatiquement par la plateforme Supabase — rien à configurer.
#
#  SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY sont fournis
#  d'office par le runtime Edge : ne les redéfinir ici que pour un test local
#  pointant vers un projet distant.
# =============================================================================

# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_ANON_KEY=<clé anon / publishable>
# SUPABASE_SERVICE_ROLE_KEY=<clé service_role — secrète>
